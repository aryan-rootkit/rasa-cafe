# Copy to .env.local and fill in. Never commit real values.

# Owner account. Anyone can also create an account at /admin/signup;
# the owner can remove those accounts on the Users screen.
ADMIN_USERNAME=admin

# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=

# Random string of 32+ characters used to sign admin sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional: where content.json and uploaded images are stored (default: ./storage)
# STORAGE_DIR=
