# Copy to .env.local and fill in. Never commit real values.
# All of these are read on the server only; never add a NEXT_PUBLIC_ prefix.

# Required: MongoDB Atlas connection string (admin users, settings, menu, hero list).
MONGODB_URI=

# Optional: database name (default: the one in the URI, or "rasacafe").
# MONGODB_DB=

# Optional: 32+ random characters used to sign admin sessions.
# If unset, one is generated automatically and kept in MongoDB.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_SECRET=

# Image uploads on Vercel: set automatically when a Blob store is connected.
# BLOB_READ_WRITE_TOKEN=

# Optional: an extra owner account that can't be removed from the dashboard.
# Generate the hash with: npm run hash-password -- "your-strong-password"
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=

# Optional: where uploaded images are stored locally (default: ./storage)
# STORAGE_DIR=
