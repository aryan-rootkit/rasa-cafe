# Everything here is optional. Copy to .env.local to use. Never commit real values.

# Random string of 32+ characters used to sign admin sessions.
# If unset, one is generated automatically and kept in storage.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_SECRET=

# An extra owner account that can't be removed from the dashboard.
# Generate the hash with: npm run hash-password -- "your-strong-password"
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=

# Where content.json and uploaded images are stored locally (default: ./storage)
# STORAGE_DIR=

# Set automatically by Vercel when a Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=
